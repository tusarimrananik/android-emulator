{
  "name": "lawnchair-web",
  "version": "14.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "build:remotion-css": "tailwindcss -i src/app/globals.css -o src/remotion/remotion.css --minify",
    "test:remotion-export": "node scripts/test-remotion-export.mjs",
    "test:render-api": "node --test scripts/test-render-api.mjs",
    "start:renderer": "node server/render-api.mjs",
    "render:videos": "npm run build:remotion-css && mkdir -p public/videos && remotion render src/remotion/index.ts DeviceViewport public/videos/lawnchair-showcase-4s.webm --codec=vp9 --crf=18 --frames=0-239 --overwrite && remotion render src/remotion/index.ts DeviceViewport public/videos/lawnchair-showcase-7s.webm --codec=vp9 --crf=18 --overwrite && remotion render src/remotion/index.ts LongWorkflow public/videos/lawnchair-showcase-30s.webm --codec=vp9 --crf=18 --overwrite"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.512",
    "@remotion/cli": "^4.0.512",
    "@remotion/media-utils": "^4.0.512",
    "@remotion/player": "^4.0.512",
    "@remotion/renderer": "^4.0.512",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.17",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.454.0",
    "next": "14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.512",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
}
